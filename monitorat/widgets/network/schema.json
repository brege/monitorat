{
  "widget": "network",
  "version": 1,
  "metadata": {
    "label": "Network",
    "emptyMessage": "No network log available."
  },
  "uptime": {
    "gradient": {
      "perfect": 100,
      "good": 95,
      "acceptable": 80
    }
  },
  "fields": [
    { "field": "timestamp", "label": "Timestamp", "format": "datetime" },
    {
      "field": "status",
      "label": "Status",
      "values": ["good", "changed", "failure"]
    },
    { "field": "ip", "label": "IP Address" },
    { "field": "message", "label": "Message" }
  ],
  "endpoints": {
    "log": "/api/network/log",
    "schema": "/api/network/schema"
  },
  "log_format": "plain_text",
  "eventTypes": {
    "outage": {
      "label": "Unknown",
      "classes": ["alert", "unknown"],
      "titleTemplate": "{missedChecks} unknown - logger not running",
      "detailTemplate": "{start} to {end} ({duration})"
    },
    "ipchange": {
      "label": "IP Changes",
      "classes": ["alert", "ipchange"],
      "titleTemplate": "IP address changed",
      "detailTemplate": "{oldIp} to {newIp} at {timestamp}"
    },
    "failure": {
      "label": "Connection Failed",
      "classes": ["alert", "failure"],
      "titleTemplate": "Connection failed",
      "detailTemplate": "{message} at {timestamp}"
    }
  }
}
