{
  "widget": "metrics",
  "version": 1,
  "api_prefix": "system",
  "endpoints": {
    "current": "api/system",
    "history": "api/system/history",
    "csv": "api/system/csv",
    "schema": "api/system/schema",
    "events": "api/system/events"
  },
  "metadata": {
    "field": "source",
    "label": "Source",
    "emptyMessage": "No metrics history yet."
  },
  "axes": {
    "x": {
      "display": true,
      "title": {
        "display": true,
        "text": "Timestamp"
      },
      "grid": {
        "display": false
      }
    },
    "y": {
      "type": "linear",
      "position": "left",
      "title": {
        "display": true,
        "text": "Value"
      },
      "grid": {
        "display": true
      }
    }
  },
  "units": {
    "percent": {
      "label": "Percent",
      "format": "number",
      "decimals": 1,
      "color": "rgb(75, 192, 192)",
      "suffix": "%"
    },
    "celsius": {
      "label": "Temperature",
      "format": "number",
      "decimals": 1,
      "color": "rgb(255, 99, 132)",
      "suffix": "°C"
    },
    "load": {
      "label": "Load Average",
      "format": "number",
      "decimals": 2,
      "color": "rgb(153, 102, 255)",
      "suffix": ""
    },
    "megabytes": {
      "label": "Megabytes",
      "format": "number",
      "decimals": 1,
      "color": "rgb(54, 162, 235)",
      "suffix": "MB"
    },
    "megabytes_per_minute": {
      "label": "MB/min",
      "format": "number",
      "decimals": 1,
      "color": "rgb(54, 162, 235)",
      "suffix": "MB/min"
    },
    "seconds": {
      "label": "Duration",
      "format": "duration",
      "decimals": 0,
      "color": "rgb(255, 159, 64)",
      "suffix": ""
    },
    "text": {
      "label": "Text",
      "format": "text",
      "decimals": 0,
      "color": "rgb(75, 85, 99)",
      "suffix": ""
    }
  },
  "eventTypes": {
    "load_1min": {
      "label": "Load (1m)",
      "classes": ["alert", "threshold"],
      "titleTemplate": "{label} threshold",
      "detailTemplate": "{value} > {threshold} at {timestamp}"
    },
    "memory_percent": {
      "label": "Memory %",
      "classes": ["alert", "threshold"],
      "titleTemplate": "{label} threshold",
      "detailTemplate": "{value} > {threshold} at {timestamp}"
    },
    "temp_c": {
      "label": "Temperature",
      "classes": ["alert", "threshold"],
      "titleTemplate": "{label} threshold",
      "detailTemplate": "{value} > {threshold} at {timestamp}"
    },
    "disk_percent": {
      "label": "Disk %",
      "classes": ["alert", "threshold"],
      "titleTemplate": "{label} threshold",
      "detailTemplate": "{value} > {threshold} at {timestamp}"
    },
    "storage_percent": {
      "label": "Storage %",
      "classes": ["alert", "threshold"],
      "titleTemplate": "{label} threshold",
      "detailTemplate": "{value} > {threshold} at {timestamp}"
    }
  }
}
