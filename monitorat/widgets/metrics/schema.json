{
  "widget": "metrics",
  "version": 1,
  "endpoints": {
    "current": "/api/metrics",
    "history": "/api/metrics/history",
    "csv": "/api/metrics/csv",
    "schema": "/api/metrics/schema"
  },
  "metadata": {
    "field": "source",
    "label": "Source",
    "emptyMessage": "No metrics history yet."
  },
  "axes": {
    "x": {
      "display": true,
      "title": {
        "display": true,
        "text": "Timestamp"
      },
      "grid": {
        "display": false
      }
    },
    "y": {
      "type": "linear",
      "position": "left",
      "title": {
        "display": true,
        "text": "Value"
      },
      "grid": {
        "display": true
      }
    }
  },
  "units": {
    "percent": {
      "label": "Percent",
      "format": "number",
      "decimals": 1,
      "color": "rgb(75, 192, 192)",
      "suffix": "%"
    },
    "celsius": {
      "label": "Temperature",
      "format": "number",
      "decimals": 1,
      "color": "rgb(255, 99, 132)",
      "suffix": "°C"
    },
    "load": {
      "label": "Load Average",
      "format": "number",
      "decimals": 2,
      "color": "rgb(153, 102, 255)",
      "suffix": ""
    },
    "megabytes": {
      "label": "Megabytes",
      "format": "number",
      "decimals": 1,
      "color": "rgb(54, 162, 235)",
      "suffix": "MB"
    },
    "seconds": {
      "label": "Duration",
      "format": "duration",
      "decimals": 0,
      "color": "rgb(255, 159, 64)",
      "suffix": ""
    },
    "text": {
      "label": "Text",
      "format": "text",
      "decimals": 0,
      "color": "rgb(75, 85, 99)",
      "suffix": ""
    }
  }
}
